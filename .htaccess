# Jack Wen Transmission — clean URL routing
# Serves extensionless URLs (/services) from the existing .html files
# without redirecting, and permanently (301) redirects any request for
# the old .html URL (or a trailing-slash variant) to its clean form, so
# each page has exactly one indexable, canonical address.

RewriteEngine On

# 1) /index.html -> / (301)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2) /anything.html -> /anything (301)
#    Matched against the ORIGINAL request line (THE_REQUEST), not the
#    post-rewrite REQUEST_URI, so this never re-fires on the internal
#    rewrite in step (4) and can't loop.
RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Strip a trailing slash from any non-directory request (301), e.g.
#    /services/ -> /services, so there is one canonical form per page.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+(.+)/[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4) Serve /anything from anything.html internally (no redirect, 200).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [L]
